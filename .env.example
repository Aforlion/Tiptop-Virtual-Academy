# Tiptop Virtual Academy (TVA 2.0) Environment Variables

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paystack API Keys (Get from https://dashboard.paystack.com/#/settings/developer)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_sample_key_here
PAYSTACK_SECRET_KEY=sk_test_sample_key_here

# Supabase Credentials (Get from https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

